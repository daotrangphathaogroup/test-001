# ============================================================
# Cấu hình môi trường — sao chép thành .env.local để chạy local
# ============================================================

# --- Supabase (bắt buộc khi deploy lên Vercel) ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Tùy chọn: đổi tên bucket lưu ảnh đại diện (mặc định: avatars)
# SUPABASE_AVATAR_BUCKET=avatars

# --- Bảo mật ---
# Bí mật ký cookie phiên đăng nhập. Bắt buộc đổi khi lên production!
# Sinh nhanh: openssl rand -base64 48
AUTH_SECRET=

# --- Tùy chọn khác ---
# URL public của trang (dùng cho link chia sẻ)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Tên lớp hiển thị
NEXT_PUBLIC_ORG_NAME=Lớp Tâm Lí Đạo Đức
# Đường dây nóng hiển thị
NEXT_PUBLIC_HOTLINE=0900 000 000

# Chỉ dùng khi KHÔNG cấu hình Supabase (môi trường dev):
#   - Mặc định: chế độ demo offline (lưu file .data/db.json) chỉ chạy được khi `npm run dev`
#   - Bắt buộc chạy demo trên production build: TLDD_LOCAL_DEMO=1
# TLDD_LOCAL_DEMO=1
# Bắt buộc dùng local backend dù đã có Supabase (gỡ rối):
# TLDD_FORCE_LOCAL=1
# Mật khẩu khởi tạo cho tài khoản thư ký mặc định (demo local):
# DEFAULT_ADMIN_PASSWORD=tldd@2026
